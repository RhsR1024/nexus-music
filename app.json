{
  "expo": {
    "name": "音枢",
    "slug": "nexus-music",
    "version": "0.1.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.nexusmusic.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "连接你配置的局域网音乐服务器并播放音乐。",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppleMusicUsageDescription": "读取你授权的设备音乐库，用于浏览和播放已在本机可用的音乐。"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
